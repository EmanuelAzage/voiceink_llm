# Copy this file to .env and fill in real values. .env is gitignored.

# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Check https://aistudio.google.com for the current free-tier model name —
# the lineup moves fast. gemini-3.5-flash-lite chosen 2026-07-30 over
# gemini-2.5-flash: live-tested equal date-extraction accuracy (9/9 vs 7/9,
# with 2.5-flash's misses being 429 rate-limit errors, not wrong answers)
# and a much higher free-tier daily cap — see decisions.md.
GEMINI_MODEL=gemini-3.5-flash-lite
