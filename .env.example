# Copy this file to .env and fill in real values. .env is gitignored.

# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Check https://aistudio.google.com for the current free-tier model name —
# the lineup moves fast. gemini-3.5-flash-lite chosen 2026-07-30 over
# gemini-2.5-flash: live-tested equal-or-better date-extraction accuracy
# (9/9 vs 8/9) and a much higher free-tier daily cap — see decisions.md.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional. Used only when GEMINI_MODEL returns HTTP 429 (rate limited) —
# extractCard() retries the whole request against this model instead, once,
# before giving up. Leave blank to disable fallback (single-model behavior).
# gemini-3.1-flash-lite chosen 2026-07-30: same-size free-tier daily cap as
# the primary (a separate quota bucket — Gemini rate-limits per model, not
# per project), and any occasional malformed field it returns is safely
# dropped by cardSchema.ts's validator rather than corrupting a card —
# see decisions.md.
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
